<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>updating</title>
</head>

<body>
    <H2></H2>EDIT YOUR LISTING</H2>
    <form method="POST" action="/listings/<%= listing._id%>?_method=PUT">
        <br>
        <input name="listing[title]" value="<%=listing.title%>">
        <br>
        <textarea name="listing[description]" placeholder="describe"><%=listing.description%></textarea>
        <br>
        <input name="listing[image]" value="<%=listing.image%>">
        <br>
        <input name="listing[price]" type="number" value="<%=listing.price%>">
        <br>
        <input name="listing[location]" value="<%=listing.location%>">
        <br>
        <input name="listing[country]" value="<%=listing.country%>">
        <br>
        <button type="submit">Submit</button>
         
    </form>
    
</body>

</html>